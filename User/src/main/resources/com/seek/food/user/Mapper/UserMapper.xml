<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seek.food.user.Mapper.UserMapper">

    <!-- 全局统一字段映射 -->
    <resultMap id="UserResultMap" type="com.seek.food.dto.User.UserDTO">
        <id property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="phoneNumber" column="phone_number"/>
        <result property="password" column="password"/>
        <result property="sex" column="sex"/>
        <result property="headerImageAddr" column="header_image_addr"/>
        <result property="birthday" column="birthday"/>
        <result property="createTime" column="create_time"/>
        <result property="isDelete" column="delete" />
        <result property="orderAmount" column="order_amount"/>
    </resultMap>

    <select id="getUserDetailMessage" resultMap="UserResultMap">
        select
        user_id,
        username,
        sex,
        header_image_addr,
        birthday,
        create_time,
        is_delete,
        order_amount
        from user where user_id=#{userId} and is_delete=false
    </select>

    <update id="updateUserPassword">
        update user set password=#{newPassword} where phone_number=#{phoneNumber} and is_delete=false
    </update>

    <update id="updateUserHeader">
        update user set header_image_addr=#{path} where user_id=#{userId}
    </update>
</mapper>