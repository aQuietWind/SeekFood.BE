<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seek.food.fund.Mapper.FundMapper">

    <!-- 全局统一字段映射 -->
    <resultMap id="FundResultMap" type="com.seek.food.dto.Fund.FundDTO">
        <id property="fundId" column="fund_id"/>
        <result property="accountId" column="account_id"/>
        <result property="createTime" column="create_time"/>
        <result property="fundAmount" column="fund_amount"/>
        <result property="isDelete" column="delete" />
    </resultMap>

    <insert id="insertFund">
        insert into fund (fund_id,account_id) values(#{fundId},#{accountId});
    </insert>

    <update id="deleteFund">
        update fund set is_delete=true where account_id=#{accountId} and is_delete=false
    </update>

</mapper>