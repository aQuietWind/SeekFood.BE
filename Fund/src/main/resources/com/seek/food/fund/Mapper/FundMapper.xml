<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seek.food.fund.Mapper.FundMapper">

    <!-- 全局统一字段映射 -->
    <resultMap id="FundResultMap" type="com.seek.food.dto.Fund.FundDTO">
        <result property="isDelete" column="delete" />
    </resultMap>

    <insert id="insertFund">
        insert into fund (account_id) values(#{accountId});
    </insert>

    <update id="deleteFund">
        update fund set is_delete=true where account_id=#{accountId} and is_delete=false
    </update>

    <update id="decreaseFund">
        update fund set fund=fund-#{cost} where account_id=#{accountId} and is_delete=false
    </update>

    <update id="increaseFund">
        update fund set fund=fund+#{rechargeAmount} where account_id=#{accountId} and is_delete=false
    </update>

</mapper>